# Copy this file to .env and fill in values. .env is gitignored.
#
# MODE=replay -> scripted demo scenarios, no model or key needed (default)
# MODE=live   -> calls an OpenAI-compatible chat endpoint (see below)
MODE=replay

# Live mode: any OpenAI-compatible endpoint.
# Free, local option (no key): Ollama  ->  ollama pull qwen2.5:7b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama

# Model that judges the "Check which memories mattered" test (live mode only).
# Can differ from LLM_MODEL, so the assistant doesn't grade itself.
JUDGE_MODEL=qwen2.5:7b

# System prompt version:
#   v2 = original, v3 = + rules for using memories,
#   v4 = + rules and each memory's source (adopted after evaluation: 10.3/14 vs v2 8.3/14)
PROMPT_VERSION=v4

# Hosted alternative (reviewer supplies their own key):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...your-own-key...