# Copy this file to .env and fill in values. .env is gitignored.
#
# MODE=replay  -> scripted demo scenarios, no model or key needed (default)
# MODE=live    -> calls an OpenAI-compatible chat endpoint
MODE=replay

# Live mode: any OpenAI-compatible endpoint.
# Free, local option (no key): Ollama  ->  ollama pull llama3.2:3b
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama

# Hosted alternative (reviewer supplies their own key):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...your-own-key...
